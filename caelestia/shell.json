"general": {
    "language": "",
    "idle": {
        "timeouts": [
            {
                "timeout": 1800,
                "idleAction": "lock"
            },
            {
                "timeout": 3600,
                "idleAction": "dpms off",
                "returnAction": "dpms on"
            },
            {
                "timeout": 7200,
                "idleAction": ["systemctl", "suspend-then-hibernate"]
            }
        ]
    }
},
"nexus": {
        "networkRescanInterval": 5000
    },
    "services": {
        "audioIncrement": 0.05,
        "sensorUnits": "Celsius",
        "weatherUnits": "Celsius"
    }
}
